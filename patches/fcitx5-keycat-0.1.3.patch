diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/KeyCatAnimation.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/KeyCatAnimation.kt
new file mode 100644
index 0000000..868c131
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/KeyCatAnimation.kt
@@ -0,0 +1,64 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+package org.fcitx.fcitx5.android.input.keyboard
+
+import android.content.Intent
+import android.inputmethodservice.InputMethodService
+import android.text.InputType
+import android.view.KeyEvent
+import android.view.inputmethod.EditorInfo
+
+internal object KeyCatAnimation {
+    private const val targetPackage = "com.keycat.android"
+    private const val actionName = "com.keycat.android.KEY_ANIMATION"
+    private const val permission = "com.keycat.android.permission.KEY_ANIMATION"
+
+    fun onKey(service: InputMethodService, action: KeyAction) {
+        val editor = service.currentInputEditorInfo ?: return
+        if (!service.isInputViewShown || !allowsAnimation(editor.inputType, editor.imeOptions)) return
+        val code = when (action) {
+            is KeyAction.FcitxKeyAction -> action.act.singleOrNull()?.let(::keyCode)
+            is KeyAction.SymAction -> when (action.sym.keyCode) {
+                KeyEvent.KEYCODE_DEL -> "Backspace"
+                KeyEvent.KEYCODE_ENTER, KeyEvent.KEYCODE_NUMPAD_ENTER -> "Enter"
+                else -> action.sym.sym.takeIf { it in 32..126 }?.toChar()?.let(::keyCode)
+            }
+            else -> null
+        } ?: return
+
+        service.sendBroadcast(
+            Intent(actionName).setPackage(targetPackage).putExtra("code", code),
+            permission,
+        )
+    }
+
+    internal fun allowsAnimation(type: Int, imeOptions: Int): Boolean {
+        if (imeOptions and EditorInfo.IME_FLAG_NO_PERSONALIZED_LEARNING != 0) return false
+        val variation = type and InputType.TYPE_MASK_VARIATION
+        // Restrict the bridge to ordinary text fields. Numeric PINs and other fields are excluded.
+        if (type and InputType.TYPE_MASK_CLASS != InputType.TYPE_CLASS_TEXT) return false
+        return variation != InputType.TYPE_TEXT_VARIATION_PASSWORD &&
+            variation != InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD &&
+            variation != InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD
+    }
+
+    internal fun keyCode(character: Char): String? = when (character) {
+        in 'a'..'z', in 'A'..'Z' -> "Key" + character.uppercaseChar()
+        in '0'..'9' -> "Digit" + character
+        in "!@#\$%^&*()" -> "Digit" + (("!@#\$%^&*()".indexOf(character) + 1) % 10)
+        ' ' -> "Space"
+        '-', '_' -> "Minus"
+        '=', '+' -> "Equal"
+        '[', '{' -> "BracketLeft"
+        ']', '}' -> "BracketRight"
+        '\\', '|' -> "Backslash"
+        ';', ':' -> "Semicolon"
+        '\'', '"' -> "Quote"
+        ',', '<' -> "Comma"
+        '.', '>' -> "Period"
+        '/', '?' -> "Slash"
+        else -> null
+    }
+}
