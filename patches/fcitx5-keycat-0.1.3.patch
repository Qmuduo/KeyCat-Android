+
+abstract class PrepareKeycatDictionary : DefaultTask() {
+    @get:Input
+    abstract val snapshot: Property<String>
+
+    @get:Input
+    abstract val sha256: Property<String>
+
+    @get:Optional
+    @get:InputFile
+    @get:PathSensitive(PathSensitivity.NONE)
+    abstract val localArchive: RegularFileProperty
+
+    @get:Internal
+    abstract val offline: Property<Boolean>
+
+    @get:OutputDirectory
+    abstract val outputDirectory: DirectoryProperty
+
+    @TaskAction
+    fun prepare() {
+        val local = localArchive.orNull?.asFile
+        check(local != null || !offline.get()) {
+            "The CC-CEDICT asset has not been prepared. Build online or set -PkeycatCedictFile to the pinned archive."
+        }
+        val bytes = local?.readBytes() ?: URI.create(snapshot.get()).toURL()
+            .openConnection().apply {
+                connectTimeout = 30_000
+                readTimeout = 45_000
+            }.getInputStream().use { it.readNBytes(4_000_001) }
+        val digest = MessageDigest.getInstance("SHA-256").digest(bytes)
+            .joinToString("") { "%02x".format(it) }
+        check(digest == sha256.get()) { "CC-CEDICT snapshot SHA-256 mismatch." }
+        outputDirectory.file("keycat-dictionary/cc-cedict.txt").get().asFile.apply {
+            parentFile.mkdirs()
+            outputStream().use { output ->
+                GZIPInputStream(bytes.inputStream()).use { it.copyTo(output) }
+            }
+        }
+    }
+}
+
+val prepareKeycatDictionary = tasks.register<PrepareKeycatDictionary>("prepareKeycatDictionary") {
+    snapshot.set("https://github.com/oxalis-ink/cc-cedict/releases/download/" +
+        "1.0%2B20261007032622/cedict_1_0_ts_utf-8_mdbg.txt.gz")
+    sha256.set("00e6c188df0056c42c0448386d0b4f532aa805d9fdd87aef139f72b421ace2f4")
+    localArchive.set(layout.file(providers.gradleProperty("keycatCedictFile").map { file(it) }))
+    offline.set(gradle.startParameter.isOffline)
+    outputDirectory.set(layout.buildDirectory.dir("generated/keycatDictionaryText"))
+}
+
+androidComponents {
+    onVariants { variant ->
+        variant.sources.assets?.addGeneratedSourceDirectory(prepareKeycatDictionary, PrepareKeycatDictionary::outputDirectory)
+    }
 }
 
