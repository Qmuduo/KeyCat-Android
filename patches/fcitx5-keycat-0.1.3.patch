diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/RetroSilver26Geometry.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/RetroSilver26Geometry.kt
new file mode 100644
index 0000000..447fce8
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/keyboard/RetroSilver26Geometry.kt
@@ -0,0 +1,34 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+package org.fcitx.fcitx5.android.input.keyboard
+
+import android.content.res.Resources
+import android.graphics.drawable.Drawable
+import kotlin.math.roundToInt
+
+internal object RetroSilver26Geometry {
+    // Reference: 1536 px across, 169 px for the bar and 701 px for the four key rows.
+    private const val DESIGN_WIDTH = 1536f
+    private const val KEY_AREA_HEIGHT = 701f
+    private const val BAR_HEIGHT = 169f
+
+    val rowHeights = listOf(182f, 175f, 174f, 170f).map { it / KEY_AREA_HEIGHT }
+    const val bottomRowWidth = 0.988f
+
+    fun keyAreaHeight(width: Int, heightPercent: Int, regularHeight: Int): Int =
+        (width * KEY_AREA_HEIGHT / DESIGN_WIDTH * heightPercent / 30).roundToInt()
+            .coerceIn(1, regularHeight.coerceAtLeast(1))
+
+    fun barHeight(keyAreaHeight: Int): Int =
+        (keyAreaHeight * BAR_HEIGHT / KEY_AREA_HEIGHT).roundToInt()
+
+    fun barBackground(resources: Resources, color: Int): Drawable =
+        insetRadiusDrawable(scale(resources, 12), scale(resources, 17), scale(resources, 19).toFloat(), color)
+
+    fun scale(resources: Resources, designPixels: Int): Int {
+        val metrics = resources.displayMetrics
+        val shortEdge = minOf(metrics.widthPixels, metrics.heightPixels)
+        return (shortEdge * designPixels / DESIGN_WIDTH).roundToInt().coerceAtLeast(1)
+    }
+}
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/candidates/CandidateEnglishDictionary.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/candidates/CandidateEnglishDictionary.kt
new file mode 100644
index 0000000..f3944f5
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/candidates/CandidateEnglishDictionary.kt
@@ -0,0 +1,49 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+package org.fcitx.fcitx5.android.input.candidates
+
+import android.content.Context
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Deferred
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.async
+import timber.log.Timber
+import java.io.IOException
+
+internal object CandidateEnglishDictionary {
+    private val scope = CoroutineScope(Dispatchers.IO)
+    private val entry = Regex("""^(\S+) (\S+) \[.*?]\s+/(.*)/\s*$""")
+    private var words: Deferred<Map<String, String>>? = null
+
+    @Synchronized
+    fun load(context: Context): Deferred<Map<String, String>> {
+        val assets = context.applicationContext.assets
+        return words ?: scope.async {
+            try {
+                assets.open("keycat-dictionary/cc-cedict.txt")
+                    .bufferedReader(Charsets.UTF_8).useLines { lines ->
+                        buildMap {
+                            lines.filterNot { it.startsWith('#') }.forEach { line ->
+                                val match = entry.matchEntire(line) ?: return@forEach
+                                val (traditional, simplified, definitions) = match.destructured
+                                val gloss = definitions.splitToSequence('/').map(String::trim)
+                                    .firstOrNull {
+                                        it.any { c -> c in 'a'..'z' || c in 'A'..'Z' } &&
+                                            !it.startsWith("CL:") &&
+                                            !it.startsWith("variant of ", ignoreCase = true) &&
+                                            !it.startsWith("see ", ignoreCase = true)
+                                    } ?: return@forEach
+                                getOrPut(simplified) { gloss }
+                                getOrPut(traditional) { gloss }
+                            }
+                        }
+                    }
+            } catch (error: IOException) {
+                Timber.w(error, "Unable to read KeyCat candidate dictionary")
+                emptyMap()
+            }
+        }.also { words = it }
+    }
+}
