+    override fun onCandidateUpdate(data: FcitxEvent.CandidateListEvent.Data) {
+        if (!theme.isRetroSilver26) return
+        val hasCandidatesNow = data.candidates.isNotEmpty()
+        if (hasCandidatesNow == hasCandidates) return
+        hasCandidates = hasCandidatesNow
+        renderPanel(lastPanel)
