     override fun onInputPanelUpdate(data: FcitxEvent.InputPanelEvent.Data) {
+        lastPanel = data
+        renderPanel(data)
+    }
+
+    private fun renderPanel(data: FcitxEvent.InputPanelEvent.Data) {
+        // The retro candidate bar displays short preedits inline. Keep the full panel for
+        // auxiliary text, longer compositions and editing in the middle of composition.
+        if (theme.isRetroSilver26 && hasCandidates && data.useInlineRetroPreedit()) {
+            ui.root.visibility = View.INVISIBLE
+            return
+        }
         ui.update(data)
         ui.root.visibility = if (ui.visible) View.VISIBLE else View.INVISIBLE
     }
 }
+
+internal fun FcitxEvent.InputPanelEvent.Data.useInlineRetroPreedit(): Boolean =
+    auxUp.isEmpty() && auxDown.isEmpty() && preedit.length in 1..8 &&
+        (preedit.cursor < 0 || preedit.cursor == preedit.length)
